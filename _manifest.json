{
  "manifest_version": 2,
  "id": "smart-tts-plugin.smart-tts",
  "version": "1.0.0",
  "name": "智能TTS",
  "description": "通过回复扩展让麦麦在回复时主动附加 TTS 语音，支持 18 家厂商（含免 key 的 Edge TTS），合成失败自动回退纯文本。",
  "author": {
    "name": "WinTerminal",
    "url": "https://github.com/WinTerminal"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WinTerminal/smart-tts",
    "homepage": "https://github.com/WinTerminal/smart-tts#readme",
    "issues": "https://github.com/WinTerminal/smart-tts/issues"
  },
  "plugin_type": "media",
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    },
    {
      "type": "python_package",
      "name": "edge-tts",
      "version_spec": ">=6.1"
    }
  ],
  "display": {
    "icon": {
      "type": "lucide",
      "value": "audio-lines"
    }
  },
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
